# ============================================
# ReferAI Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Supabase (Required for Frontend) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Database (Required for NestJS API / Prisma) ---
DATABASE_URL=postgresql://referai:password@localhost:5432/referai_db

# --- NestJS API ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_PORT=3001

# --- Docker PostgreSQL ---
POSTGRES_USER=referai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=referai_db
